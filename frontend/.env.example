# ============================================================
# SITARA Frontend — Environment Variables Template
# ============================================================
# Salin file ini ke .env.local untuk development lokal:
#   cp .env.example .env.local
#
# Untuk production (Vercel/Railway), set langsung di dashboard,
# BUKAN lewat file ini.
# ============================================================

# Nama aplikasi
VITE_APP_NAME=SITARA

# URL backend Laravel API
# Development lokal: kosongkan (otomatis pakai localhost:8000)
# Production      : isi dengan URL backend deployment
# Contoh: https://sitara-backend.railway.app/api
# Vercel/Cloudflare Tunnel: https://evident-parts-action-instructional.trycloudflare.com/api
VITE_API_BASE_URL=https://evident-parts-action-instructional.trycloudflare.com/api
